# Alchemy app integration. Add the real value only to local .env or a secret manager.
# Never commit .env or place API keys in source code, logs, URLs in diagnostics, or chat.
ALCHEMY_API_KEY=

# Adapter selection is explicit; production defaults remain read-only.
ALCHEMY_ENABLED=false
ALCHEMY_READ_ONLY=true
ALCHEMY_SOLANA_NETWORK=solana-mainnet
ALCHEMY_ETHEREUM_NETWORK=eth-mainnet
ALCHEMY_ARBITRUM_NETWORK=arb-mainnet

# Endpoint templates; runtime code must inject the key without logging the resulting URL.
ALCHEMY_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ALCHEMY_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
